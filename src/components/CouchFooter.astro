---
// CouchFooter.astro — Blue shirt tumbles from above the page and lands on the couch
---

<div class="cf-outer" id="cf-outer" aria-hidden="true">
  <picture>
    <source srcset="/images/couch-scene-background.webp" type="image/webp" />
    <img class="cf-bg" src="/images/couch-scene-background.png" alt="" />
  </picture>
  <!-- Settled canvas — only drawn after landing -->
  <canvas class="cf-canvas" id="cf-canvas"></canvas>
  <div class="cf-fade-top"></div>
</div>

<!-- Overlay canvas for the tumble — sits above all page content -->
<canvas class="cf-overlay" id="cf-overlay" aria-hidden="true"></canvas>

<style>
.cf-outer {
  position: relative;
  width: 100vw;
  margin-left: calc(50% - 50vw);
  height: clamp(252px, 40vw, 750px); /* 40% taller */
  overflow: hidden;
  margin-top: 64px;
}

.cf-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 50% 45%; /* show more upper scene */
}

.cf-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

/* Soft fade from page background into the scene */
.cf-fade-top {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 48px;
  background: linear-gradient(to bottom, var(--bg, #0d1117), transparent);
  pointer-events: none;
}

/* Full-page overlay canvas for the tumble phase */
.cf-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  z-index: 9999;
  display: none; /* shown only during animation */
}
</style>

<script is:inline>
(function() {
  var outer   = document.getElementById('cf-outer');
  var settled = document.getElementById('cf-canvas');
  var overlay = document.getElementById('cf-overlay');
  if (!outer || !settled || !overlay) return;

  var sCtx = settled.getContext('2d');
  var oCtx = overlay.getContext('2d');

  var OW, OH;   // overlay (viewport) dimensions
  var SW, SH;   // settled canvas (footer) dimensions

  var DPR = window.devicePixelRatio || 1;

  function resizeSettled() {
    var cssW = outer.offsetWidth;
    var cssH = outer.offsetHeight;
    settled.width  = cssW * DPR;
    settled.height = cssH * DPR;
    settled.style.width  = cssW + 'px';
    settled.style.height = cssH + 'px';
    sCtx.setTransform(DPR, 0, 0, DPR, 0, 0);
    SW = cssW;
    SH = cssH;
  }

  function resizeOverlay() {
    var cssW = window.innerWidth;
    var cssH = window.innerHeight;
    overlay.width  = cssW * DPR;
    overlay.height = cssH * DPR;
    overlay.style.width  = cssW + 'px';
    overlay.style.height = cssH + 'px';
    oCtx.setTransform(DPR, 0, 0, DPR, 0, 0);
    OW = cssW;
    OH = cssH;
  }

  resizeSettled();
  resizeOverlay();
  window.addEventListener('resize', function() {
    resizeSettled();
    resizeOverlay();
    if (isDone) drawSettled();
  });

  /* ── Load blue shirt frames (lazy — deferred until footer is near) ── */
  var FRAME_COUNT  = 75;  // 000–072 tumble/settle, 073–074 fist-bump poses
  var frames       = [];
  var framesLoaded = 0;

  function pad3(n) { return n < 10 ? '00'+n : n < 100 ? '0'+n : ''+n; }

  function loadFrame(idx) {
    var img = new Image();
    img.onload  = function() { framesLoaded++; };
    img.onerror = function() { framesLoaded++; };
    img.src = '/images/blue-shirt-animation/frames/frame_' + pad3(idx) + '.png';
    frames[idx] = img;
  }

  function loadFrames() {
    /* Priority: frames used in first ~1s of animation (tumble start: 71 down to ~55)
       plus the settled/fist-bump frames (72, 73, 74). Load these first. */
    var priority = [74, 73, 72, 71, 70, 69, 68, 67, 66, 65, 64, 63, 62, 61, 60];
    priority.forEach(function(i) { loadFrame(i); });
    /* Load remaining frames after a short delay so priority frames win bandwidth */
    setTimeout(function() {
      for (var i = 0; i < FRAME_COUNT; i++) {
        if (!frames[i]) loadFrame(i);
      }
    }, 300);
  }

  /* ── Load Sam poses (4 unique images, named) ── */
  var SAM_POSES = ['seated', 'startled', 'looking-up', 'composed'];
  var samImgs   = {};
  var samLoaded = 0;

  SAM_POSES.forEach(function(name) {
    var img = new Image();
    img.onload  = function() { samLoaded++; };
    img.onerror = function() { samLoaded++; };
    img.src = '/images/sam-reaction-animation/poses/' + name + '.png';
    samImgs[name] = img;
  });

  /* ── Load Astronaut poses ── */
  var ASTRO_POSES = [
    'seated', 'turn-toward-sam', 'facing-sam',
    'fist-raise', 'fist-extend', 'fist-bump',
    'glance-up-start', 'glance-up-hold',
    'thumbs-up-raise', 'thumbs-up-hold'
  ];
  var astroImgs   = {};
  var astroLoaded = 0;

  ASTRO_POSES.forEach(function(name) {
    var img = new Image();
    img.onload  = function() { astroLoaded++; drawCanvas(); };
    img.onerror = function() { astroLoaded++; };
    img.src = '/images/astronaut-animation/poses/' + name + '.png';
    astroImgs[name] = img;
  });

  /* ── Astronaut seat position (back of couch, between Sam and blue shirt) ── */
  var ASTRO_NX = 0.66;
  var ASTRO_NY = 0.37;
  var ASTRO_SZ = 0.20;

  function astroSeat() {
    var scale = Math.max(SW / IMG_W, SH / IMG_H);
    var rendW = IMG_W * scale;
    var rendH = IMG_H * scale;
    var ox    = (SW - rendW) / 2;
    var oy    = -(rendH - SH) * OBJ_POS_Y;
    var lx    = ox + ASTRO_NX * rendW;
    var ly    = oy + ASTRO_NY * rendH;
    return { lx: lx, ly: ly, size: rendW * ASTRO_SZ };
  }

  var astroPose = 'seated';

  /* ── Sam seat position (left couch cushion) ── */
  var SAM_NX   = 0.52;
  var SAM_NY   = 0.39;
  var SAM_SZ   = 0.22;

  function samSeat() {
    var scale  = Math.max(SW / IMG_W, SH / IMG_H);
    var rendW  = IMG_W * scale;
    var rendH  = IMG_H * scale;
    var ox     = (SW - rendW) / 2;
    var oy     = -(rendH - SH) * OBJ_POS_Y;
    var lx     = ox + SAM_NX * rendW;
    var ly     = oy + SAM_NY * rendH;
    return { lx: lx, ly: ly, size: rendW * SAM_SZ };
  }

  /* ── Seat position in footer ──
     bg image: 1619×971 px, object-fit:cover, object-position:50% 75%
     left cushion: nx=0.49, ny=0.51, sz=0.29
  */
  var SEAT_NX   = 0.75;
  var SEAT_NY   = 0.56;
  var IMG_W     = 1619;
  var IMG_H     = 971;
  var OBJ_POS_Y = 0.45;   // matches object-position: 50% 45%
  var _charSize = 0.33;   // fraction of rendered image width

  /* Returns seat {x, y} in VIEWPORT coords, and character size */
  function seatViewport() {
    var rect   = outer.getBoundingClientRect();
    var scale  = Math.max(SW / IMG_W, SH / IMG_H);
    var rendW  = IMG_W * scale;
    var rendH  = IMG_H * scale;
    var ox     = (SW - rendW) / 2;
    var oy     = -(rendH - SH) * OBJ_POS_Y;
    /* seat in footer-local coords */
    var lx = ox + SEAT_NX * rendW;
    var ly = oy + SEAT_NY * rendH;
    return {
      x:    rect.left + lx,
      y:    rect.top  + ly,
      size: rendW * _charSize,
      /* also return footer-local seat for the settled canvas */
      lx:   lx,
      ly:   ly
    };
  }

  /* ── Animation state ── */
  var ANIM_DUR = 4500;
  var startTime = null;
  var rafId     = null;
  var triggered = false;
  var isDone    = false;

  function draw(now) {
    if (!startTime) startTime = now;
    var elapsed = now - startTime;
    var t       = Math.min(1, elapsed / ANIM_DUR);

    oCtx.clearRect(0, 0, OW, OH);

    var seat   = seatViewport();
    var charSz = seat.size;

    var frameIdx, x, y, rot, opacity;

    if (t < 0.5) {
      /* Phase 1: tumbling in from top-right of viewport */
      var p    = t / 0.5;
      var ease = p * p * (3 - 2 * p);
      frameIdx = Math.round(71 - ease * 35);   // 71 → 36

      var startX = OW + charSz * 0.5;           // just off right edge
      var startY = -charSz * 0.5;               // just above viewport top — visible immediately
      var midX   = seat.x;
      var midY   = seat.y - charSz * 1.5;       // hover above couch

      x       = startX + (midX - startX) * ease;
      y       = startY + (midY - startY) * ease;
      rot     = (1 - ease) * 400;
      opacity = Math.min(1, p * 2.5);

    } else if (t < 0.85) {
      /* Phase 2: drop to seat */
      var p    = (t - 0.5) / 0.35;
      var ease = p * p * (3 - 2 * p);
      frameIdx = ease < 0.97 ? Math.round(35 - ease * 33) : 72;  // 35 → 2 → 72

      var midX = seat.x;
      var midY = seat.y - charSz * 1.5;

      x       = midX + (seat.x - midX) * ease;
      y       = midY + (seat.y - midY) * ease;
      rot     = (1 - ease) * 25;
      opacity = 1;

    } else {
      /* Phase 3: tiny bounce settle */
      var p      = (t - 0.85) / 0.15;
      var bounce = Math.sin(p * Math.PI) * 8 * (1 - p);
      frameIdx   = 72;
      x          = seat.x;
      y          = seat.y - bounce;
      rot        = 0;
      opacity    = 1;
    }

    frameIdx = Math.max(0, Math.min(72, frameIdx));
    var img  = frames[frameIdx];

    if (img && img.complete && img.naturalWidth) {
      oCtx.save();
      oCtx.globalAlpha = opacity;
      oCtx.translate(x, y);
      oCtx.rotate(rot * Math.PI / 180);
      oCtx.drawImage(img, -charSz / 2, -charSz / 2, charSz, charSz);
      oCtx.restore();
    }

    if (t < 1) {
      rafId = requestAnimationFrame(draw);
    } else {
      /* Landing done — hide overlay, draw settled pose on footer canvas */
      overlay.style.display = 'none';
      isDone = true;
      drawCanvas();
      startBsAnim();
    }
  }

  /* ── Astronaut pose animation ── */
  var ASTRO_SEQUENCE = [
    { pose: 'seated',          hold: 400   },
    { pose: 'turn-toward-sam', hold: 350   },
    { pose: 'glance-up-start', hold: 350   },
    { pose: 'glance-up-hold',  hold: 800   },
    { pose: 'facing-sam',      hold: 600   },
    { pose: 'fist-raise',      hold: 350   },
    { pose: 'fist-extend',     hold: 300   },
    { pose: 'fist-bump',       hold: 700   },
    { pose: 'fist-raise',      hold: 300   },  // retract
    { pose: 'facing-sam',      hold: 400   },
    { pose: 'thumbs-up-raise', hold: 350   },
    { pose: 'thumbs-up-hold',  hold: 99999 }   // rest
  ];
  var astroPoseIdx = 0;
  var astroPoseAt  = null;
  var astroAnimOn  = false;
  var astroRafId   = null;

  function astroLoop(now) {
    if (!astroPoseAt) astroPoseAt = now;
    var step = ASTRO_SEQUENCE[astroPoseIdx];
    if (now - astroPoseAt >= step.hold) {
      astroPoseIdx++;
      if (astroPoseIdx >= ASTRO_SEQUENCE.length) { astroAnimOn = false; return; }
      astroPoseAt = now;
      astroPose = ASTRO_SEQUENCE[astroPoseIdx].pose;
    }
    drawCanvas();
    if (astroAnimOn) astroRafId = requestAnimationFrame(astroLoop);
  }

  function startAstroAnim() {
    if (astroAnimOn) return;
    astroAnimOn  = true;
    astroPoseIdx = 0;
    astroPoseAt  = null;
    astroPose    = ASTRO_SEQUENCE[0].pose;
    drawCanvas();
    astroRafId = requestAnimationFrame(astroLoop);
  }

  /* ── Sam pose animation ── */
  var SAM_SEQUENCE = [
    { pose: 'looking-up', hold: 800   },
    { pose: 'startled',   hold: 600   },
    { pose: 'looking-up', hold: 1200  },
    { pose: 'composed',   hold: 1000  },
    { pose: 'seated',     hold: 99999 }  // rest
  ];
  var samPoseIdx  = 0;
  var samPoseAt   = null;  // timestamp when current pose started
  var samAnimOn   = false;
  var samRafId    = null;
  var samCurrentPose = 'seated';

  function drawCanvas() {
    sCtx.clearRect(0, 0, SW, SH);
    /* Sam on left cushion — always */
    var ss = samSeat();
    var samImg = samImgs[samCurrentPose];
    if (samImg && samImg.complete && samImg.naturalWidth) {
      sCtx.drawImage(samImg, ss.lx - ss.size / 2, ss.ly - ss.size / 2, ss.size, ss.size);
    }
    /* Astronaut between Sam and blue shirt — always */
    var as = astroSeat();
    var aImg = astroImgs[astroPose];
    if (aImg && aImg.complete && aImg.naturalWidth) {
      sCtx.drawImage(aImg, as.lx - as.size / 2, as.ly - as.size / 2, as.size, as.size);
    }
    /* Blue shirt on right cushion — only after his animation is done */
    if (isDone) {
      var seat = seatViewport();
      var img  = frames[bsFrame];
      if (img && img.complete && img.naturalWidth) {
        sCtx.drawImage(img, seat.lx - seat.size / 2, seat.ly - seat.size / 2, seat.size, seat.size);
      }
    }
  }

  /* ── Blue shirt fist-bump animation ── */
  /* Blue shirt fist-bump timing math (all times from scroll trigger):
     Blue shirt lands:          4500ms
     Astro fist-bump starts:    2250 + 400+350+350+800+600+350+300 = 6050ms
     BS wait until bump frame:  4500 + 1200 + 350 = 6050ms  ✓
  */
  var BS_SEQUENCE = [
    { frame: 72, hold: 350   },   // settled — wait for astro to reach fist-extend
    { frame: 73, hold: 350   },   // fist raise (mirrors astro fist-extend → fist-bump)
    { frame: 74, hold: 700   },   // fist bump hold (matches astronaut's 700ms)
    { frame: 73, hold: 300   },   // retract
    { frame: 72, hold: 99999 }    // rest
  ];
  var bsIdx    = 0;
  var bsAt     = null;
  var bsFrame  = 72;
  var bsAnimOn = false;
  var bsRafId  = null;

  function bsLoop(now) {
    if (!bsAt) bsAt = now;
    var step = BS_SEQUENCE[bsIdx];
    if (now - bsAt >= step.hold) {
      bsIdx++;
      if (bsIdx >= BS_SEQUENCE.length) { bsAnimOn = false; return; }
      bsAt    = now;
      bsFrame = BS_SEQUENCE[bsIdx].frame;
    }
    drawCanvas();
    if (bsAnimOn) bsRafId = requestAnimationFrame(bsLoop);
  }

  function startBsAnim() {
    if (bsAnimOn) return;
    bsAnimOn = true;
    bsIdx    = 0;
    bsAt     = null;
    bsFrame  = BS_SEQUENCE[0].frame;
    bsRafId  = requestAnimationFrame(bsLoop);
  }

  function samLoop(now) {
    if (!samPoseAt) samPoseAt = now;
    var step = SAM_SEQUENCE[samPoseIdx];
    if (now - samPoseAt >= step.hold) {
      samPoseIdx++;
      if (samPoseIdx >= SAM_SEQUENCE.length) { samAnimOn = false; return; }
      samPoseAt = now;
      samCurrentPose = SAM_SEQUENCE[samPoseIdx].pose;
      drawCanvas();
    }
    if (samAnimOn) samRafId = requestAnimationFrame(samLoop);
  }

  function startSamAnim() {
    if (samAnimOn) return;
    samAnimOn   = true;
    samPoseIdx  = 0;
    samPoseAt   = null;
    samCurrentPose = SAM_SEQUENCE[0].pose;
    drawCanvas();
    samRafId = requestAnimationFrame(samLoop);
  }

  function drawSettled() {
    drawCanvas();
  }

  /* ── Pre-load frames when footer is within 1.5× viewport height ── */
  var preloadObs = new IntersectionObserver(function(entries) {
    if (entries[0].isIntersecting) {
      preloadObs.disconnect();
      loadFrames();
    }
  }, { rootMargin: '150% 0px', threshold: 0 });
  preloadObs.observe(outer);

  /* ── Trigger animation when footer is actually in view ── */
  var obs = new IntersectionObserver(function(entries) {
    if (entries[0].isIntersecting && !triggered) {
      triggered = true;
      obs.disconnect();
      function tryStart() {
        if (framesLoaded >= 15) {
          /* Draw Sam seated immediately */
          drawCanvas();
          /* Sam reacts after blue shirt's Phase 1 ends (2250ms) */
          setTimeout(startSamAnim, 2250);
          setTimeout(startAstroAnim, 2250);
          overlay.style.display = 'block';
          resizeOverlay(); // ensure canvas dims are set before first draw
          rafId = requestAnimationFrame(draw);
        } else {
          setTimeout(tryStart, 80);
        }
      }
      tryStart();
    }
  }, { threshold: 0.2 });

  obs.observe(outer);

  /* ── Dev helper: tweak from console ──
     Positions (take effect immediately):
       window._cf.nx  / ny  / sz   → blue shirt left/right / up/down / size
       window._cf.snx / sny / ssz  → Sam
       window._cf.anx / any / asz  → Astronaut

     Fist-bump timing (edit then replay):
       window._cf.bs           → view the BS_SEQUENCE array
       window._cf.bs[0].hold = 600   → delay before blue shirt raises fist
       window._cf.bs[1].hold = 300   → fist raise duration
       window._cf.bs[2].hold = 800   → fist bump hold duration

     Astronaut timing (edit then replay):
       window._cf.astro        → view the ASTRO_SEQUENCE array
       window._cf.astro[5].hold = 400  → fist-raise duration (step 6)
       window._cf.astro[7].hold = 800  → fist-bump hold duration (step 8)

     window._cf.replay()    → re-run everything from scratch
  */
  window._cf = {
    get bs()   { return BS_SEQUENCE; },
    get astro(){ return ASTRO_SEQUENCE; },
    get nx() { return SEAT_NX; },
    set nx(v) { SEAT_NX = v; drawSettled(); console.log('nx =', v); },
    get ny() { return SEAT_NY; },
    set ny(v) { SEAT_NY = v; drawSettled(); console.log('ny =', v); },
    get sz() { return _charSize; },
    set sz(v) { _charSize = v; drawSettled(); console.log('sz =', v); },
    get anx() { return ASTRO_NX; },
    set anx(v) { ASTRO_NX = v; drawCanvas(); console.log('anx =', v); },
    get any() { return ASTRO_NY; },
    set any(v) { ASTRO_NY = v; drawCanvas(); console.log('any =', v); },
    get asz() { return ASTRO_SZ; },
    set asz(v) { ASTRO_SZ = v; drawCanvas(); console.log('asz =', v); },
    get snx() { return SAM_NX; },
    set snx(v) { SAM_NX = v; drawSettled(); console.log('snx =', v); },
    get sny() { return SAM_NY; },
    set sny(v) { SAM_NY = v; drawSettled(); console.log('sny =', v); },
    get ssz() { return SAM_SZ; },
    set ssz(v) { SAM_SZ = v; drawSettled(); console.log('ssz =', v); },
    replay: function() {
      isDone = false; triggered = false; startTime = null;
      samAnimOn = false; samPoseIdx = 0; samPoseAt = null; samCurrentPose = 'seated';
      astroAnimOn = false; astroPoseIdx = 0; astroPoseAt = null; astroPose = 'seated';
      bsAnimOn = false; bsIdx = 0; bsAt = null; bsFrame = 72;
      sCtx.clearRect(0, 0, SW, SH);
      drawCanvas();
      setTimeout(startSamAnim,   2250);
      setTimeout(startAstroAnim, 2250);
      overlay.style.display = 'block';
      rafId = requestAnimationFrame(draw);
    }
  };

})();
</script>
