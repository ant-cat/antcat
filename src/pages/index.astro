      camera.updateMatrixWorld();
      if(flying) tvWorld.copy(flying.tv); else unprojectTV(tvWorld);

      // Canopy + title + dunes
      cGroup.rotation.y=t*0.045+smx*0.32; cGroup.rotation.x=-smy*0.20;
      tGroup.position.y=titleY+Math.sin(t*0.4)*0.06;
      updateTerrain(t);

      var introOp=0,introFade=0;
      if(activated){
        if(!activatedAt) activatedAt=t;
        var sinceAct=t-activatedAt;
        introFade=Math.min(1.0,sinceAct/INTRO_DUR);
        introOp=Math.min(1.0,sinceAct/1.0);
        if(bgMesh) bgMesh.material.uniforms.uOpacity.value=Math.min(1.0,sinceAct/1.2);
      }
      glyphMats.forEach(function(obj){obj.mat.opacity=activated?obj.base*introFade*elemPulse(obj.elemIdx,t):0;});
      terrMat.opacity=0.6*introFade;
      canopyLines.material.opacity=(isPort?0.12:0.45);
      canopyNodes.material.opacity=(isPort?0.3:1.0);

      // Emitter cone aimed from the CRT glass toward the viewer
      _camBase.set(0,2,camZ);
      _seg.subVectors(_camBase,tvWorld); var camDist=_seg.length(); _segN.copy(_seg).normalize();
      emitter.position.copy(tvWorld);
      emitter.quaternion.setFromUnitVectors(_yAxis,_segN);
      coneOuter.scale.set(1,camDist*0.62,1);
      coneInner.scale.set(1,camDist*0.5,1);
      var anyHot=0; words.forEach(function(w){ anyHot=Math.max(anyHot,w.hover); });
      [coneOuter,coneInner].forEach(function(cm){ cm.material.uniforms.uTime.value=t; cm.material.uniforms.uOpacity.value=introOp; cm.material.uniforms.uHot.value=anyHot; });
      screenGlow.position.copy(tvWorld);
      var sg=(1.7+0.15*Math.sin(t*3.1)+0.5*anyHot); screenGlow.scale.set(sg*1.3,sg,1);
      screenGlow.material.opacity=introOp*(0.4+0.08*Math.sin(t*17.0));

      // Focal eye: rays turn slowly, the iris follows the pointer, and it blinks now and then
      if(t>nextBlink && blinkStart<0){ blinkStart=t; }
      var lidOpen=1;
      if(blinkStart>=0){
        var bp=(t-blinkStart)/0.22;
        if(bp>=1){ blinkStart=-1; nextBlink=t+3+Math.random()*4; }
        else lidOpen=1-0.92*Math.sin(Math.PI*bp);
      }
      var eyeWide=1+0.1*anyHot, es=EYE_SIZE*(1+0.03*Math.sin(t*1.7));
      [eyeRays,eyeLid,eyeIris].forEach(function(sp){ sp.position.copy(tvWorld); });
      eyeRays.scale.set(es,es,1);
      if(introOp>0 && t-lastRaysDraw>1/30){ drawRays(t); lastRaysDraw=t; }
      eyeLid.scale.set(es*eyeWide, es*eyeWide*lidOpen, 1);
      var irisS=es*(1-0.08*anyHot);
      eyeIris.scale.set(irisS, irisS*lidOpen, 1);
      eyeIris.position.x+=smx*es*0.11; eyeIris.position.y-=smy*es*0.05;
      eyeIris.material.rotation=-t*0.25;
      var eo=introOp*(0.85+0.15*Math.sin(t*2.3));
      eyeRays.material.opacity=eo*0.8; eyeLid.material.opacity=eo; eyeIris.material.opacity=eo*(lidOpen>0.3?1:lidOpen/0.3);

      // Hover target: pointer pick, else keyboard focus
      if(activated&&!flying){
        scene.updateMatrixWorld();
        var ph=pointerIn?pickWord(pointerX,pointerY):-1;
        if(ph<0&&focusIdx>=0) ph=focusIdx;
        if(ph!==hoverIdx){
          hoverIdx=ph;
          document.body.style.cursor=ph>=0?'pointer':'';
        }
      }

      var sizeMul=layoutMul;
      words.forEach(function(w,wi){
        var targetH=flying?(flying.wi===wi?1:0):(hoverIdx===wi?1:0);
        w.hover+=(targetH-w.hover)*0.12;
        var h=w.hover;
        var hot=h>0.35;
        var vis=activated?introFade*(flying&&flying.wi!==wi?Math.max(0,1-flying.e*1.6):1):0;

        // Front cap position with parallax drift (deeper nodes drift less)
        w.front.set(w.base.x+smx*0.35, w.base.y-smy*0.22+Math.sin(t*0.6+w.phase)*0.05, w.base.z);
        w.tiltX+=((-smy*0.22)-w.tiltX)*0.07;
        w.tiltY+=((smx*0.30)-w.tiltY)*0.07;

        // Projection ray from TV glass to the front cap; hover pushes the cap forward
        _seg.subVectors(w.front,tvWorld); var len=_seg.length(); _segN.copy(_seg).normalize();
        w.cap.copy(w.front).addScaledVector(_segN,0.6*h);
        // Accordion: idle strata bunch up behind the cap, hover fans them out down the ray
        var expo=lerp(0.5,1.1,h);
        var pulse=elemPulse(CHARS.length+wi,t);
        for(var s=0;s<SLICES;s++){
          var m=w.slices[s];
          var tt=s/(SLICES-1);
          var u=Math.pow(tt,expo);
          if(s>0&&s<SLICES-1) u=clamp01(u+h*0.018*Math.sin(t*7.0-s*0.6));
          // slicePosition = frontPos + (tvScreenCenter - frontPos) * (1 - u)
          m.position.copy(w.cap).addScaledVector(_capPos.subVectors(tvWorld,w.cap),1-u);
          var sc=(0.08+0.92*u)*sizeMul*(1+0.08*h);
          m.scale.set(sc,sc,1);
          m.rotation.set(w.tiltX,w.tiltY,0);
          var isCap=(s===SLICES-1);
          var map=isCap?(hot?w.tex.capHot:w.tex.cap):(hot?w.tex.strataHot:w.tex.strata);
          if(m.material.map!==map) m.material.map=map;
          if(isCap){
            m.material.color.setRGB(1,1,1);
            m.material.opacity=vis*Math.min(1,(0.82+0.18*pulse)*(1+0.3*h));
          } else {
            _cold.copy(_deep).lerp(_near,u);
            if(h>0.01) _cold.lerp(_hotDeep.clone().lerp(_hotNear,u*u),h*0.85);
            m.material.color.copy(_cold).multiplyScalar(1+0.5*h);
            var nearCap=clamp01((u-0.7)/0.3); nearCap=nearCap*nearCap*(3-2*nearCap);
            m.material.opacity=vis*Math.min(1,(0.07+0.4*Math.pow(u,1.5))*(0.8+0.2*pulse)*(1+1.4*h*(1-u*u)))*(1-0.92*h*nearCap);
          }
        }
      });

      if(activated) drawBeams(introOp,t); else bctx.clearRect(0,0,bc.width,bc.height);
      renderer.render(scene,camera);
    }
    animate();
  })();
  </script>
</body>
</html>
