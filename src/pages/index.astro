---
// Full-viewport splash — clicking nav zooms into the TV, then navigates
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="ant.cat — Anthony Catanese" />
  <title>ant.cat</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />
  <link rel="icon" type="image/png" href="/favicon.png" />
</head>
<body>

  <div class="stage" id="stage">
    <img class="hero-img" id="heroImg" src="/images/hero.png" alt="" />

    <!-- Brand -->
    <div class="brand">ant.cat <em>lab</em></div>

    <!-- Nav links -->
    <nav class="splash-nav">
      <a class="nav-link" href="/writing">Mind Grapes</a>
      <a class="nav-link" href="/experiments">Experiments</a>
      <a class="nav-link" href="/about">About</a>
      <a class="nav-link" href="/now">Now</a>
    </nav>

    <!-- Tagline -->
    <div class="tagline">Built this for me, but you can read it too.</div>

    <!-- Zoom overlay (black) fades in on top during transition -->
    <div class="zoom-overlay" id="zoomOverlay"></div>
  </div>

</body>
</html>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #0a0a0a;
  }

  .stage {
    position: relative;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
  }

  /* Hero image fills viewport, slight Ken Burns idle drift */
  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    transform-origin: center center;
    animation: idleDrift 18s ease-in-out infinite alternate;
    transition: transform 1.2s cubic-bezier(0.4, 0, 0.2, 1),
                transform-origin 0s;
    will-change: transform;
    user-select: none;
    pointer-events: none;
  }

  @keyframes idleDrift {
    0%   { transform: scale(1.04) translate(0%, 0%); }
    100% { transform: scale(1.08) translate(-1.5%, -1%); }
  }

  /* Dark gradient at bottom */
  .stage::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0,0,0,0.65) 0%,
      rgba(0,0,0,0.2) 40%,
      rgba(0,0,0,0.0) 70%
    );
    pointer-events: none;
    z-index: 1;
  }

  /* Brand top-left */
  .brand {
    position: absolute;
    top: 28px;
    left: 32px;
    z-index: 10;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: rgba(255,255,255,0.9);
    text-shadow: 0 1px 6px rgba(0,0,0,0.5);
  }
  .brand em { font-style: normal; color: rgba(255,255,255,0.5); }

  /* Nav — centered horizontally, upper third */
  .splash-nav {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .nav-link {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(2.4rem, 5.5vw, 4.2rem);
    font-weight: 400;
    color: rgba(255,255,255,0.92);
    text-decoration: none;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-shadow: 0 2px 20px rgba(0,0,0,0.6);
    transition: color 0.2s, text-shadow 0.2s;
    cursor: pointer;
  }

  .nav-link:hover {
    color: #fff;
    text-shadow: 0 0 40px rgba(255,255,255,0.3), 0 2px 20px rgba(0,0,0,0.7);
  }

  /* Tagline bottom-left */
  .tagline {
    position: absolute;
    bottom: 28px;
    left: 32px;
    z-index: 10;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
    text-shadow: 0 1px 4px rgba(0,0,0,0.5);
  }

  /* Black overlay for the zoom transition */
  .zoom-overlay {
    position: absolute;
    inset: 0;
    background: #000;
    opacity: 0;
    pointer-events: none;
    z-index: 20;
    transition: opacity 0.4s ease;
  }
  .zoom-overlay.fading { opacity: 1; pointer-events: all; }

  /* Zooming state on the image */
  .hero-img.zooming {
    animation: none;
    transition: transform 1.1s cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
  }

  @media (max-width: 600px) {
    .nav-link { font-size: clamp(1.8rem, 9vw, 2.8rem); }
    .brand { top: 20px; left: 20px; }
    .tagline { left: 20px; bottom: 20px; }
  }
</style>

<script is:inline>
(function () {

  // The TV screen in the hero image lives roughly at 58% from left, 45% from top.
  // These coords are the transform-origin we zoom toward.
  var TV_X = 58;  // percent from left
  var TV_Y = 45;  // percent from top

  var heroImg = document.getElementById('heroImg');
  var overlay = document.getElementById('zoomOverlay');

  function zoomTo(href) {
    // 1. Stop idle drift, set transform-origin to TV center
    heroImg.classList.add('zooming');
    heroImg.style.transformOrigin = TV_X + '% ' + TV_Y + '%';

    // 2. Scale up dramatically (zoom into the TV)
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        heroImg.style.transform = 'scale(8)';
      });
    });

    // 3. Fade overlay to black a bit after zoom starts
    setTimeout(function () {
      overlay.classList.add('fading');
    }, 600);

    // 4. Navigate once black
    setTimeout(function () {
      window.location.href = href;
    }, 1100);
  }

  // Attach to all nav links
  var links = document.querySelectorAll('.nav-link');
  links.forEach(function (link) {
    link.addEventListener('click', function (e) {
      e.preventDefault();
      var href = link.getAttribute('href');
      zoomTo(href);
    });
  });

})();
</script>

